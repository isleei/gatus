# Copy to .env and fill in real values (never commit .env).
# Unset / empty URLs cause Gatus to fail fast with ErrEndpointWithNoURL.

# Primary Gatus base URL (no trailing slash). Sentinel probes ${GATUS_PRIMARY_URL}/health
GATUS_PRIMARY_URL=https://status.example.com

# WeCom robot webhook (placeholder only — inject real secret via env/secrets manager)
GATUS_WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=REPLACE

# Critical business health probes watched by the sentinel
GATUS_SENTINEL_CRITICAL_URL_1=https://app.example.com/health
GATUS_SENTINEL_CRITICAL_URL_2=https://api.example.com/health
